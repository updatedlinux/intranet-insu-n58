# Ejemplo mínimo para PROD_ENV_FILE (GitLab, tipo File).
# Copiar, completar secretos y subir como variable de proyecto.
#
# ── NO incluir hosts de infraestructura ─────────────────────────────────────
# DB_SERVER, REDIS_HOST, MINIO_ENDPOINT, REDIS_ENABLED y MINIO_ENABLED los
# inyecta el job Nomad (127.0.0.1 dentro del mismo allocation). Si los
# pones aquí, el job los sobrescribe igualmente en la task API.
#
# ── Sí necesitas credenciales, puertos y config de negocio ────────────────

NODE_ENV=production
PORT=3000

CORS_ORIGIN=https://intranet.insularcambios.com
APP_URL=https://intranet.insularcambios.com

# SQL — host omitido; solo credenciales y nombre de BD
DB_PORT=1433
DB_NAME=insular_intranet
DB_USER=sa
DB_PASSWORD=cambiar-clave-sa
# deploy.sh fuerza MSSQL_SA_PASSWORD = DB_PASSWORD (no hace falta duplicar en GitLab).
DB_ENCRYPT=false

# MinIO — endpoint omitido; keys las usa la API y el contenedor MinIO del job
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=kA8u6eFtpF4CrJ8ngWt7Cnra+kv01vlCMwXQwxkIN8E=
MINIO_BUCKET=insular-docs

# Redis — host omitido; password la usa la API y redis-server del job
REDIS_PORT=6379
REDIS_PASSWORD=kA8u6eFtpF4CrJ8ngWt7Cnra+kv01vlCMwXQwxkIN8E=

JWT_SECRET=kA8u6eFtpF4CrJ8ngWt7Cnra+kv01vlCMwXQwxkIN8E=
JWT_EXPIRES_IN=24h
AUTH_COOKIE_NAME=intranet_session

SMTP_HOST=send.insularcambios.com
# IP del relay Postal (Nomad también inyecta SMTP_CONNECT_HOST=${smtp_relay_ip})
SMTP_CONNECT_HOST=172.28.163.15
SMTP_PORT=25
SMTP_SECURE=false
# Relay Postal en :25 sin STARTTLS
SMTP_IGNORE_TLS=true
# Credencial SMTP de Postal (Organization → Servers → Credentials). Obligatorio: sin esto → 530 Authentication required
SMTP_USER=cambiar-usuario-postal
SMTP_PASSWORD=cambiar-password-postal
SMTP_FROM_NAME=N58 Banco Digital
SMTP_FROM_EMAIL=no-reply@insularcambios.com
