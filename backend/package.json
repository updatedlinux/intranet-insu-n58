{
  "name": "@intranet/backend",
  "version": "1.0.0",
  "description": "API REST de la Intranet Corporativa",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --exit-child --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/run-db-migrate.js up",
    "migrate:undo": "node scripts/run-db-migrate.js down -c 1",
    "migrate:status": "node scripts/run-db-migrate.js check",
    "data:reset": "node scripts/reset-data-to-zero.js",
    "data:reset:execute": "node scripts/reset-data-to-zero.js --execute",
    "smoke:documents": "node scripts/smoke-document-flow.js",
    "smoke:announcements": "node scripts/smoke-announcements.js",
    "smoke:service-desk": "node scripts/smoke-service-desk.js",
    "smoke:activities": "node scripts/smoke-activities.js",
    "smoke:requests": "node scripts/smoke-requests.js",
    "smoke:learning": "node scripts/smoke-learning.js"
  },
  "keywords": [
    "intranet",
    "express",
    "typescript"
  ],
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1058.0",
    "@aws-sdk/s3-request-presigner": "^3.1058.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "db-migrate": "^0.11.14",
    "db-migrate-mssql": "^2.1.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "iconv-lite": "^0.7.3",
    "ioredis": "^5.11.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "mssql": "^12.5.5",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.10",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
