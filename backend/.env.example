NODE_ENV=development
PORT=3000

# CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# URL pública de la intranet (enlaces "Ver comunicado" en correos)
APP_URL=http://localhost:5173

# SQL Server
DB_SERVER=10.200.1.229
DB_PORT=1433
DB_NAME=insular_intranet
DB_USER=sa
DB_PASSWORD=P@ssw0rd
DB_ENCRYPT=false

# MinIO (S3-compatible)
# MINIO_ENABLED=false  # omitir MinIO al arrancar (dev sin VPN al servidor de archivos)
MINIO_ENDPOINT=10.200.1.179
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin 
MINIO_SECRET_KEY=TuPasswordSeguro123!
MINIO_BUCKET=insular-docs
# URL pública del bucket (opcional; ej. http://10.200.1.179:9000/insular-docs)
# MINIO_PUBLIC_BASE_URL=

# Redis (sesiones, rate limit login)
# REDIS_ENABLED=false  # dev sin Redis: sesiones solo por JWT
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# SMTP (Postal)
SMTP_HOST=send.insularcambios.com
# IP del relay Postal (conexión TCP directa; en Nomad se inyecta SMTP_CONNECT_HOST)
SMTP_CONNECT_HOST=172.28.163.15
SMTP_PORT=25
SMTP_SECURE=false
# En relay interno :25 sin cifrado
SMTP_IGNORE_TLS=true
# Credencial SMTP de Postal (obligatorio en producción)
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Insular Cambios
SMTP_FROM_EMAIL=
# SMTP_TLS_REJECT_UNAUTHORIZED=false

# JWT
JWT_SECRET=EP2nmG9tj8LC9uHqnICdtmKg7MQsXbiMao5QASuEfhE+qF25fLzRBOOvVQ+OiBIV7P1Qg131bMvvzXbvN4Jh5w==
JWT_EXPIRES_IN=24h
AUTH_COOKIE_NAME=intranet_session

# Migraciones (opcional: contraseña temporal del admin inicial en 005-seed-initial-data)
# SEED_ADMIN_PASSWORD=ChangeMe123!

# --- Producción (Nomad / PROD_ENV_FILE) ---
# Ver deploy/prod.env.example — NO incluir DB_SERVER, REDIS_HOST ni MINIO_ENDPOINT:
# el job Nomad los fija en 127.0.0.1 (misma allocation que SQL, Redis y MinIO).
# CORS_ORIGIN y APP_URL = https://intranet.insularcambios.com
# Datos persistentes del nodo: /logs/insular/intranet/{sqlserver,minio,redis}

