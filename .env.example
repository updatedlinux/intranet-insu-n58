# Copia a .env antes de: docker compose up --build
# Credenciales solo para desarrollo local / QA con Compose (no producción Nomad).

NODE_ENV=development

# URLs públicas (navegador → frontend nginx)
CORS_ORIGIN=http://localhost:8080
APP_URL=http://localhost:8080

# Puertos publicados en el host
WEB_PUBLISH_PORT=8080
API_PUBLISH_PORT=3000
DB_PUBLISH_PORT=1433
MINIO_PUBLISH_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PUBLISH_PORT=6379

# SQL Server (Compose inyecta DB_SERVER=sqlserver en el servicio api)
DB_NAME=insular_intranet
DB_USER=sa
# Mínimo 8 chars, mayúscula, minúscula, número y símbolo (requisito MSSQL)
DB_PASSWORD=Intranet_Dev_Sa1!
DB_ENCRYPT=false

# MinIO
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=Intranet_Dev_Minio1!
MINIO_BUCKET=insular-docs
MINIO_PUBLIC_BASE_URL=http://localhost:9000/insular-docs

# Redis
REDIS_PASSWORD=Intranet_Dev_Redis1!

# JWT (cambiar en cualquier entorno compartido)
JWT_SECRET=change-me-local-dev-jwt-secret-min-32-chars!!
JWT_EXPIRES_IN=24h
AUTH_COOKIE_NAME=intranet_session

# SMTP opcional en local (sin Postal el envío de correo fallará)
# SMTP_HOST=
# SMTP_CONNECT_HOST=
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_IGNORE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_NAME=N58 Banco Digital
# SMTP_FROM_EMAIL=noreply@localhost
